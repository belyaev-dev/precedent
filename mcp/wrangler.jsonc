{
  // For local development and tests only: `wrangler dev` and the end-to-end suite read this file. This Worker
  // is not deployed with wrangler. It has no public route; the website Worker in ../web reaches it over a
  // service binding, and that deployment (Alchemy) declares its own bindings.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "precedent-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  // agents/mcp/server uses AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],
  // Compiles cards/*.yaml into the bundled index before every dev run. That index is what the Worker serves
  // whenever the CORPUS bucket below has no index.json, as it does locally unless one is put there.
  "build": { "command": "node scripts/build-corpus.mjs", "watch_dir": ["src", "scripts", "../cards", "../schema"] },
  // The private bucket the full index is read from, as index.json, at run time. Locally wrangler gives the
  // binding an empty bucket of its own (nothing is read from or written to the real one), so the Worker
  // falls back to the bundled index.
  "r2_buckets": [{ "binding": "CORPUS", "bucket_name": "precedent-corpus" }],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      // Any integer not already used for another rate limit in the account.
      "namespace_id": "1001",
      // Per client address (per /64 for IPv6), per Cloudflare location, approximate. Period must be 10 or 60
      // seconds. 120 a minute is a brake on a runaway loop, set high enough for a dozen agent sessions behind
      // one shared address; the README says how it was chosen. The binding is optional in the code, and the
      // end-to-end suite uses this one to test the limiter.
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  // Keep the Worker's own count lines (no query text, no addresses). Do not record request metadata,
  // and keep tracing off explicitly, so that a later compatibility date cannot switch it on.
  "observability": { "enabled": true, "logs": { "invocation_logs": false }, "traces": { "enabled": false } }
}
